%%{init: {"theme":"base","themeVariables":{"background":"#ffffff","primaryColor":"#f7f7f7","primaryTextColor":"#1a1a1a","primaryBorderColor":"#8a8a8a","lineColor":"#555555","secondaryColor":"#efefef","tertiaryColor":"#ffffff","edgeLabelBackground":"#ffffff","clusterBkg":"#fafafa","clusterBorder":"#bbbbbb","titleColor":"#1a1a1a","nodeTextColor":"#1a1a1a"}}}%%
flowchart TD

    subgraph P0["1. 화재 당일 밤"]
      FIRE["불은 꺼졌다.<br/>소방차가 떠나고, 나는 타버린 집 앞에 서 있다.<br/>이제 뭘 해야 하지?"]
      FIRE --> CARD["화재조사관이 명함을 건넨다<br/>뒷면에 QR 하나 — '여기 열어보시면 됩니다'"]
      CARD --> OPEN["휴대폰으로 연다<br/>가입 없음 · 로그인 없음 · 개인정보 안 받음<br/>우리 구는 QR이 이미 알고 있다"]
      OPEN --> ASK["내 상황을 답한다 (10분, 14~17개)<br/>세입자인가 · 보험은 있나 · 물에 젖었나<br/>모르면 '모르겠다'를 골라도 된다 —<br/>그래도 안전한 쪽으로 안내한다"]
    end

    ASK --> FIRST["지금 내 상황에 맞는 할 일 목록이 나온다"]

    FIRST --> TODAY["오늘 하실 것<br/>· 냉장고 음식은 4시간 안에<br/>· 치우기 전에 방마다 사진부터"]
    FIRST --> DONT["당분간 하지 마실 것<br/>· 젖은 가전에 전원 넣지 않기<br/>· 원인일지 모르는 제품 버리지 않기<br/>· '그 자리에서 책임 인정' 하지 않기"]
    FIRST --> ADDR["이 주소를 저장하세요<br/>[나에게 카톡 보내기]<br/>이 주소가 곧 내 기록이다"]

    subgraph P1["2. 며칠 뒤 — 정신이 좀 들었을 때"]
      BACK["저장한 주소로 다시 연다<br/>같은 휴대폰이면 자동으로 이어진다"]
      BACK --> CHECK["한 일은 체크, 남은 일이 보인다"]
      CHECK --> WEEK["이번 주에 하실 것<br/>화재증명원 발급 · 조사서 신청 ..."]
      CHECK --> WAITING["기다리는 것<br/>화재현장조사서: 보름~2개월<br/>지금이 무엇을 기다리는 시간인지 알려준다"]
      VISIT["손해사정사가 찾아왔다"] --> UPD["답 하나만 바꾸면 화면이 바뀐다<br/>'지금 온 그 사람은 내 편이 아니다'<br/>'무료로 내 편이 되어줄 창구는 따로 있다'"]
    end

    ADDR -.->|며칠 뒤| BACK

    subgraph P2["3. 조사서가 나온 뒤"]
      REPORT["화재현장조사서를 받았다<br/>발화 지점과 원인이 적혀 있다"]
      REPORT --> UPD2["답을 고친다<br/>예: '현관등에서 발화 — 제조물 결함 의심'"]
      UPD2 --> AFTER["잠겨 있던 안내가 열린다<br/>· 공용부 발화면 세입자 책임이 아닐 수 있다<br/>· 무료 분쟁조정 · 리콜 조회 · 소멸시효 3년"]
    end

    WAITING -.->|보름~2개월| REPORT

    subgraph P3["내내 함께 도는 것 — 우리 구 지원 판정"]
      GU["같은 화재라도 구마다 조례가 다르다<br/>내 답으로 자동 판정"]
      GU --> YES["해당<br/>신청처와 기한을 알려준다"]
      GU --> COND["조건부<br/>원칙은 제외지만 긴급 예외 있음 — 구청 문의"]
      GU --> NO["제외<br/>숨기지 않고 왜 안 되는지 말해준다"]
    end

    FIRST -.-> GU

    NOTE["이 서비스의 약속<br/>시간이 지나면 되돌릴 수 없는 일을 맨 앞에 ·<br/>내가 할 수 없는 일은 보여주지 않는다 ·<br/>같은 주소는 석 달 뒤에 열어도 그날에 맞는 할 일을 보여준다"]
    AFTER -.-> NOTE

    style FIRE fill:#fce8e6,stroke:#8a8a8a,color:#1a1a1a
    style FIRST fill:#fff4e5,stroke:#8a8a8a,color:#1a1a1a
    style TODAY fill:#fff4e5,stroke:#8a8a8a,color:#1a1a1a
    style DONT fill:#fce8e6,stroke:#8a8a8a,color:#1a1a1a
    style ADDR fill:#e8f0fe,stroke:#8a8a8a,color:#1a1a1a
    style WAITING fill:#efefef,stroke:#8a8a8a,color:#1a1a1a
    style UPD fill:#fff4e5,stroke:#8a8a8a,color:#1a1a1a
    style AFTER fill:#e6f4ea,stroke:#8a8a8a,color:#1a1a1a
    style YES fill:#e6f4ea,stroke:#8a8a8a,color:#1a1a1a
    style COND fill:#fff4e5,stroke:#8a8a8a,color:#1a1a1a
    style NO fill:#fce8e6,stroke:#8a8a8a,color:#1a1a1a
    style NOTE fill:#e8f0fe,stroke:#8a8a8a,color:#1a1a1a
